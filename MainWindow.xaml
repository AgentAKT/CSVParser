<Window x:Class="CSVParser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CSVParser"
        mc:Ignorable="d"
        Title="CSV Parser" Height="464" Width="594" Icon="/coffeecup.png" ResizeMode="CanResize">

    <Window.Resources>
        <!-- Стиль для кнопок -->
        <Style x:Key="StyledButton" TargetType="Button">
            <Setter Property="Background" Value="#FFE6F0F9" />
            <!-- Светло-голубой -->
            <Setter Property="Foreground" Value="#FF1F3A4D" />
            <!-- Темно-синий -->
            <Setter Property="Padding" Value="10,5" />
            <!-- Увеличенный отступ -->
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#FF90A4AE" />
            <!-- Серо-голубой -->
            <Setter Property="FontSize" Value="12" />
            <!-- Увеличенный размер шрифта -->
            <Setter Property="FontWeight" Value="SemiBold" />
            <!-- Полужирный шрифт -->
            <Setter Property="Cursor" Value="Hand" />
            <!-- Курсор в виде руки -->
            <Setter Property="OverridesDefaultStyle" Value="True" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="3"
                                SnapsToDevicePixels="True">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextOptions.TextRenderingMode="ClearType"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="2" Color="#FF888888" Opacity="0.5"/>
                </Setter.Value>
            </Setter>

            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="2" Color="#FF888888" Opacity="0.5" />
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFBBDEFB" />
                    <!-- Более яркий синий при наведении -->
                    <Setter Property="BorderBrush" Value="#FF64B5F6" />
                    <!-- Яркая граница при наведении -->
                    <Setter Property="Foreground" Value="#FF0D47A1" />
                    <!-- Более темный текст при наведении -->
                </Trigger>

                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FF90CAF9" />
                    <!-- Еще более яркий синий при нажатии -->
                    <Setter Property="BorderBrush" Value="#FF42A5F5" />
                    <!-- Яркая граница при нажатии -->
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для текстовых полей -->
        <Style x:Key="StyledTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#FFF0F0F0"/>
            <Setter Property="Foreground" Value="#FF333333"/>
            <Setter Property="BorderBrush" Value="#FF999999"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
        </Style>
    </Window.Resources>

    <!-- Основной контейнер -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="50" />
        </Grid.ColumnDefinitions>

        <!-- Определяем строки -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Лейбл "Выбрать импортированный из Навигатора данных csv файл" -->
            <RowDefinition Height="Auto" />
            <!-- Лейбл "Файл" -->
            <RowDefinition Height="Auto" />
            <!-- Лейбл "Путь к папке с csv файлами" -->
            <RowDefinition Height="Auto" />
            <!-- Лейбл "Путь" -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Лейбл "Выбрать импортированный из Навигатора данных csv файл" -->
        <Label Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2" Content="Выбрать импортированный из Навигатора данных csv файл" FontSize="12" Margin="5,0,0,0"/>

        <!-- Лейбл "Файл" -->
        <StackPanel Grid.Column="0" Grid.Row="1" Orientation="Horizontal" Margin="10,0,0,0">
            <Label x:Name="pathLabel1" Content="Файл:" Margin="10,5,5,35" VerticalAlignment="Center"/>
            <Button x:Name="pathToFileBtn" Content="Файл" FontSize="11" Style="{StaticResource StyledButton}" Click="PathToFileBtn_Click" Margin="10,5,5,35" Height="25" Width="64" HorizontalAlignment="Left" RenderTransformOrigin="1.817,0.568" />
        </StackPanel>

        <StackPanel Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="5,5,5,5">
            <TextBox x:Name="pathFileTextBox" Style="{StaticResource StyledTextBox}" TextWrapping="Wrap" Margin="5,5,5,35" TextChanged="pathFileTextBox_TextChanged" Height="20" Width="328"/>
        </StackPanel>

        <!-- Кнопка sortedUIDs перемещается на вторую строку -->
        <Button x:Name="sortedUIDs" Grid.Column="2" Grid.Row="1" Grid.ColumnSpan="3" FontSize="11" Content="Сортировать UIDы" Style="{StaticResource StyledButton}"  Margin="5,40,5,5" Height="25" Width="110" HorizontalAlignment="Left" RenderTransformOrigin="1.817,0.568" Click="sortedUIDs_Click" />

        <!-- Лейбл "Путь к папке с csv файлами" -->
        <Label Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2" Content="Путь к папке с csv файлами" Margin="10,0,0,0" FontSize="12"/>

        <!-- Лейбл "Путь" -->
        <StackPanel Grid.Column="0" Grid.Row="3" Orientation="Horizontal" Margin="10,5,5,5">
            <Label x:Name="pathLabel" Content="Путь:" Margin="8,5,5,35" VerticalAlignment="Center"/>
            <Button x:Name="pathBtn" Content="Папка" FontSize="11" Style="{StaticResource StyledButton}" Click="PathBtn_Click" Margin="8,5,5,35" Height="25" Width="64" HorizontalAlignment="Left" />
        </StackPanel>

        <StackPanel Grid.Column="1" Grid.Row="3" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="5,5,5,10">
            <TextBox x:Name="pathTextBox" Style="{StaticResource StyledTextBox}" TextWrapping="Wrap" Margin="5,5,5,35" KeyDown="PathTextBox_KeyDown" TextChanged="pathTextBox_TextChanged" Height="20" Width="328"/>
        </StackPanel>

        <!-- Остальные элементы -->
        <CheckBox x:Name="CheckBoxMeasurements" Grid.Column="0" Grid.Row="4" Content="В файле есть замеры" Checked="CheckBox_Unchecked" Margin="10,5,5,5" Unchecked="CheckBox_Checked" FontSize="10" VerticalAlignment="Bottom" />
        <CheckBox x:Name="CheckBoxSmartNTFile" Grid.Column="1" Grid.Row="4" Content="SmartNTFile" Checked="CheckBox_Unchecked" FontSize="10" Margin="5,5,5,5" />

        <Label x:Name="numberOfColumnLabel" Grid.Column="0" Grid.Row="5" Content="Номер столбца с UID:" Margin="10,5,5,5" FontSize="10"/>
        <TextBox x:Name="numberOfColumnTextBox" Grid.Column="1" Grid.Row="5" Style="{StaticResource StyledTextBox}" Margin="5,5,5,5" Width="77" HorizontalAlignment="Left" TextChanged="numberOfColumnTextBox_TextChanged_1" Text="1" />

        <Label x:Name="numberOfColumnLabel2" Grid.Column="0" Grid.Row="6" Content="Номер столбца с измерениями:" Margin="10,5,5,5" FontSize="10"/>
        <TextBox x:Name="numberOfColumnMeasurements" Grid.Column="1" Grid.Row="6" Style="{StaticResource StyledTextBox}" Margin="5,5,5,5" Width="77" HorizontalAlignment="Left" Text="2" />

        <Label x:Name="numberOfValuesLabel" Grid.Column="0" Grid.Row="7" Content="Количество значений:" FontSize="10" Margin="10,5,5,5"/>
        <TextBox x:Name="numberOfValuesTextBox" Grid.Column="1" Grid.Row="7" Style="{StaticResource StyledTextBox}" Width="77" Margin="5,5,5,5" HorizontalAlignment="Left" Text="4"/>

        <Label x:Name="valuesRandomLabel" Grid.Column="0" Grid.Row="8" Content="Значения (рандом): от" FontSize="10" Margin="10,5,5,5" HorizontalAlignment="Left"/>
        <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="8" Margin="0,0,0,0">
            <TextBox x:Name="valuesRandomFromTextBox" Style="{StaticResource StyledTextBox}" Width="77" Margin="5,5,5,5" HorizontalAlignment="Left" Text="100" />
            <Label x:Name="valueToLabel" Content="до" FontSize="10" Margin="5,5,5,5"/>
            <TextBox x:Name="valuesRandomToTextBox" Style="{StaticResource StyledTextBox}" Width="77" Margin="5,5,5,5" HorizontalAlignment="Left" Text="200"/>
        </StackPanel>

        <Label x:Name="timeRandomLabel" Grid.Column="0" Grid.Row="9" Content="Время (рандом): от" FontSize="10" Margin="10,5,5,5"/>
        <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="9" Margin="0,0,0,0">
            <TextBox x:Name="timeRandomFromTextBox" Style="{StaticResource StyledTextBox}" Width="77" Margin="5,5,5,5" HorizontalAlignment="Left" Text="10"/>
            <Label x:Name="timeToLabel" Content="до" FontSize="10" Margin="5,5,5,5"/>
            <TextBox x:Name="timeRandomToTextBox" Style="{StaticResource StyledTextBox}" Width="77" Margin="5,5,5,5" HorizontalAlignment="Left" Text="60" />
        </StackPanel>

        <Label x:Name="processedFilesLabel" Grid.Column="2" Grid.ColumnSpan="3" Grid.Row="5" Content="Найдено .csv файлов:" Margin="10,5,5,5" FontSize="10"/>
        <Label x:Name="processedFilesLabelValue" Grid.Column="3" Grid.Row="5" Content="0" Width="77" Margin="5,5,5,5" FontSize="10" HorizontalAlignment="Left"/>

        <Label x:Name="processedRowsLabel" Grid.Column="2" Grid.Row="6" Content="Обработано строк:" Margin="10,5,5,5" FontSize="10"/>
        <Label x:Name="processedRowsLabelValue" Grid.Column="3" Grid.Row="6" Content="0" FontSize="10" Width="77" Margin="5,5,5,5" HorizontalAlignment="Left"/>

        <Label x:Name="collectedUIDsLabel_Copy1" Grid.Column="2" Grid.Row="7" Content="Записано в файл:" Margin="10,5,5,5" FontSize="10"/>
        <Label x:Name="writeToFileUIDsLabelValue" Grid.Column="3" Grid.Row="7" Content="0" FontSize="10" Width="77" Margin="5,5,5,5" HorizontalAlignment="Left"/>

        <Button x:Name="collectUIDs" Grid.Column="2" Grid.Row="3" Grid.ColumnSpan="3" FontSize="11" Content="Обработать UIDы" Style="{StaticResource StyledButton}" Click="CollectUIDs_Click" Margin="5,40,5,5" Height="25" Width="110" HorizontalAlignment="Left" />

        <Label Content="© Team78 (UAT)" Grid.Column="0" Grid.Row="12" HorizontalAlignment="Left" IsEnabled="False" Margin="15,5,5,5"/>
    </Grid>
</Window>