<Window x:Class="CSVParser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CSVParser"
        mc:Ignorable="d"
        Title="CSV Parser" Height="375" Width="594" Icon="/coffeecup.png" ResizeMode="CanResize">

    <Window.Resources>
        <!-- Стиль для кнопок -->
        <Style x:Key="StyledButton" TargetType="Button">
            <Setter Property="Background" Value="#FFDDDDDD"/>
            <Setter Property="Foreground" Value="#FF333333"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#FF999999"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="2" Color="#FF888888" Opacity="0.5"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для текстовых полей -->
        <Style x:Key="StyledTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#FFF0F0F0"/>
            <Setter Property="Foreground" Value="#FF333333"/>
            <Setter Property="BorderBrush" Value="#FF999999"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <!-- Первый столбец -->
            <ColumnDefinition Width="*" />
            <!-- Второй столбец -->
            <ColumnDefinition Width="150" />
            <!-- Третий столбец -->
            <ColumnDefinition Width="50" />
        </Grid.ColumnDefinitions>

        <!-- Определяем 13 строк -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <!-- Последний ряд позволяет заполнить оставшееся пространство -->
        </Grid.RowDefinitions>

        <!-- Вторая строка становится первой -->
        <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal" Margin="10,5,5,5">
            <Label x:Name="pathLabel1" Content="Файл:" VerticalAlignment="Center"/>
            <Button x:Name="pathToFileBtn" Content="Файл" Style="{StaticResource StyledButton}" Click="PathToFileBtn_Click" Margin="5,5,5,5" Height="31" Width="64" HorizontalAlignment="Left" RenderTransformOrigin="1.817,0.568" />
        </StackPanel>

        <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" Margin="5,5,5,5">
            <TextBox x:Name="pathFileTextBox" Style="{StaticResource StyledTextBox}" TextWrapping="Wrap" Margin="5,5,5,5" TextChanged="pathFileTextBox_TextChanged" Width="Auto"/>
        </StackPanel>

        <!-- Кнопка sortedUIDs перемещается на вторую строку -->
        <Button x:Name="sortedUIDs" Grid.Column="2" Grid.Row="0" Content="Сортировать UIDы" Style="{StaticResource StyledButton}"  Margin="5,5,5,5" Height="31" Width="110" HorizontalAlignment="Left" RenderTransformOrigin="1.817,0.568" Click="sortedUIDs_Click" />

        <!-- Первая строка становится третьей -->
        <StackPanel Grid.Column="0" Grid.Row="2" Orientation="Horizontal" Margin="10,5,5,5">
            <Label x:Name="pathLabel" Content="Путь:" VerticalAlignment="Center"/>
            <Button x:Name="pathBtn" Content="Папка" Style="{StaticResource StyledButton}" Click="PathBtn_Click" Margin="8,5,5,5" Height="31" Width="64" HorizontalAlignment="Left" />
        </StackPanel>

        <StackPanel Grid.Column="1" Grid.Row="2" Orientation="Horizontal" Margin="5,5,5,10">
            <TextBox x:Name="pathTextBox" Style="{StaticResource StyledTextBox}" TextWrapping="Wrap" Margin="5,5,5,5" KeyDown="PathTextBox_KeyDown" TextChanged="pathTextBox_TextChanged" Width="Auto"/>
        </StackPanel>

        <!-- Чекбоксы остаются на своих местах -->
        <CheckBox x:Name="CheckBoxMeasurements" Grid.Column="0" Grid.Row="3" Content="В файле есть замеры" Checked="CheckBox_Unchecked" Margin="10,5,5,5" Unchecked="CheckBox_Checked" FontSize="10" VerticalAlignment="Bottom" />
        <CheckBox x:Name="CheckBoxSmartNTFile" Grid.Column="1" Grid.Row="3" Content="SmartNTFile" Checked="CheckBox_Unchecked" FontSize="10" Margin="5,5,5,5" />

        <!-- Номер столбца c UID -->
        <Label x:Name="numberOfColumnLabel" Grid.Column="0" Grid.Row="4" Content="Номер столбца с UID:" Margin="10,5,5,5" FontSize="10"/>
        <TextBox x:Name="numberOfColumnTextBox" Grid.Column="1" Grid.Row="4" Style="{StaticResource StyledTextBox}" Margin="5,5,5,5" Width="77" HorizontalAlignment="Left" TextChanged="numberOfColumnTextBox_TextChanged_1" Text="1" />

        <!-- Номер столбца с измерениями -->
        <Label x:Name="numberOfColumnLabel2" Grid.Column="0" Grid.Row="5" Content="Номер столбца с измерениями:" Margin="10,5,5,5" FontSize="10"/>
        <TextBox x:Name="numberOfColumnMeasurements" Grid.Column="1" Grid.Row="5" Style="{StaticResource StyledTextBox}" Margin="5,5,5,5" Width="77" HorizontalAlignment="Left" Text="2" />

        <!-- Количество значений -->
        <Label x:Name="numberOfValuesLabel" Grid.Column="0" Grid.Row="6" Content="Количество значений:" FontSize="10" Margin="10,5,5,5"/>
        <TextBox x:Name="numberOfValuesTextBox" Grid.Column="1" Grid.Row="6" Style="{StaticResource StyledTextBox}" Width="77" Margin="5,5,5,5" HorizontalAlignment="Left" Text="4"/>

        <!-- Значения (рандом) -->
        <Label x:Name="valuesRandomLabel" Grid.Column="0" Grid.Row="7" Content="Значения (рандом): от" FontSize="10" Margin="10,5,5,5" HorizontalAlignment="Left"/>
        <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="7" Margin="0,0,0,0">
            <TextBox x:Name="valuesRandomFromTextBox" Style="{StaticResource StyledTextBox}" Width="77" Margin="5,5,5,5" HorizontalAlignment="Left" Text="100" />
            <Label x:Name="valueToLabel" Content="до" FontSize="10" Margin="5,5,5,5"/>
            <TextBox x:Name="valuesRandomToTextBox" Style="{StaticResource StyledTextBox}" Width="77" Margin="5,5,5,5" HorizontalAlignment="Left" Text="200"/>
        </StackPanel>

        <!-- Время (рандом) -->
        <Label x:Name="timeRandomLabel" Grid.Column="0" Grid.Row="8" Content="Время (рандом): от" FontSize="10" Margin="10,5,5,5"/>
        <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="8" Margin="0,0,0,0">
            <TextBox x:Name="timeRandomFromTextBox" Style="{StaticResource StyledTextBox}" Width="77" Margin="5,5,5,5" HorizontalAlignment="Left" Text="10"/>
            <Label x:Name="timeToLabel" Content="до" FontSize="10" Margin="5,5,5,5"/>
            <TextBox x:Name="timeRandomToTextBox" Style="{StaticResource StyledTextBox}" Width="77" Margin="5,5,5,5" HorizontalAlignment="Left" Text="60" />
        </StackPanel>

        <!-- Статистика -->
        
        <Label x:Name="processedFilesLabel" Grid.Column="2" Grid.Row="4" Content="Найдено .csv файлов:" Margin="10,5,5,5" FontSize="10"/>
        <Label x:Name="processedFilesLabelValue" Grid.Column="3" Grid.Row="4" Content="0" Width="77" Margin="5,5,5,5" FontSize="10" HorizontalAlignment="Left"/>

        <Label x:Name="processedRowsLabel" Grid.Column="2" Grid.Row="5" Content="Обработано строк:" Margin="10,5,5,5" FontSize="10"/>
        <Label x:Name="processedRowsLabelValue" Grid.Column="3" Grid.Row="5" Content="0" FontSize="10" Width="77" Margin="5,5,5,5" HorizontalAlignment="Left"/>

        <Label x:Name="collectedUIDsLabel_Copy1" Grid.Column="2" Grid.Row="6" Content="Записано в файл:" Margin="10,5,5,5" FontSize="10"/>
        <Label x:Name="writeToFileUIDsLabelValue" Grid.Column="3" Grid.Row="6" Content="0" FontSize="10" Width="77" Margin="5,5,5,5" HorizontalAlignment="Left"/>

        <!-- Кнопка обработки -->
        <Button x:Name="collectUIDs" Grid.Column="2" Grid.Row="2" Content="Обработать UIDы" Style="{StaticResource StyledButton}" Click="CollectUIDs_Click" Margin="5,5,5,5" Height="31" Width="110" HorizontalAlignment="Left" />

        <!-- Подпись -->
        <Label Content="© Team78 (UAT)" Grid.Column="0" Grid.Row="12" HorizontalAlignment="Left" IsEnabled="False" Margin="15,5,5,5"/>
    </Grid>
</Window>